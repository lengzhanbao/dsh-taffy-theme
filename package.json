{
  "name": "@dsh-external/dsh-taffy-theme",
  "version": "0.2.2",
  "description": "Taffy Live Atelier / 塔菲直播工房 — candy acrylic DSH Web theme: light conservatory & dark stage art, gold-pink chat frame, Taffy overlays, optional agent preset.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "license": "MIT",
  "author": "lengzhanbao",
  "homepage": "https://github.com/lengzhanbao/dsh-taffy-theme#readme",
  "bugs": {
    "url": "https://github.com/lengzhanbao/dsh-taffy-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengzhanbao/dsh-taffy-theme.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "ui",
    "ui-theme",
    "webui",
    "taffy",
    "acrylic",
    "light-dark"
  ],
  "scripts": {
    "assets:defringe": "python scripts/defringe-left-light.py",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:static": "node scripts/verify-taffy.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:peers": "node scripts/verify-peers.mjs",
    "verify:preset": "node scripts/verify-preset.mjs",
    "verify": "node scripts/verify-taffy.mjs",
    "ci": "npm run verify:peers && npm run verify:preset && npm run verify:assets && npm run verify:static && npm run typecheck && npm test && npm run verify:pack",
    "capture:hint": "node scripts/capture-hint.mjs",
    "install:dev": "powershell -ExecutionPolicy Bypass -File scripts/install-dev.ps1",
    "install:release": "powershell -ExecutionPolicy Bypass -File scripts/install-release.ps1",
    "prebuild": "node scripts/verify-assets.mjs",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 && npm run build:client",
    "build:client": "npx tsdown",
    "build:ci": "node scripts/prepare-build.mjs && npx tsdown && tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npx vitest run",
    "prepublishOnly": "npm run build && npm test && npm run verify:static && npm run verify:pack"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./skin.json": "./skin.json"
  },
  "files": [
    "lib/index.js",
    "lib/config.js",
    "lib/boot-taffy.js",
    "lib/assets/route.js",
    "lib/assets/manifest.js",
    "lib/assets/trust-fence.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/prompt/taffy-system.md",
    "lib/prompt/loader.js",
    "cordis.patch.yml",
    "skin.json",
    "presets",
    "assets/taffy/*.webp",
    "assets/taffy/icons/*.webp",
    "assets/taffy/backgrounds/*.webp",
    "assets/taffy/sidebar/*.webp",
    "assets/taffy/chibi/*.webp",
    "assets/taffy/LICENSE.txt",
    "assets/taffy/manifest.json",
    "assets/taffy/baseline.json",
    "preview/light.webp",
    "preview/dark.webp",
    "docs/usage.zh.md",
    "docs/usage.en.md",
    "docs/install.zh.md",
    "docs/install.en.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/taffy.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@types/node": "^24.13.3",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "semver": "^7.6.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}


